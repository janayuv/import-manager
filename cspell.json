{
  "version": "0.2",
  "language": "en",
  "useGitignore": true,
  "files": ["**/*"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/.pnpm-store/**",
    "**/.yarn/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/.cache/**",
    "**/.vite/**",
    "**/target/**",
    "**/coverage/**",
    "**/tmp/**",
    "**/temp/**",
    "**/out/**",
    "**/bin/**",
    "**/obj/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "**/test-results-runner/**",
    "**/CICD/node_modules/**",
    "**/CICD/dist/**",
    "**/agent-tools/**",
    "**/terminals/**",
    "**/codeql_data/**",
    "**/agent-transcripts/**",
    "**/.cursor/**",
    "**/.git/**",
    "**/*.min.js",
    "**/*.svg",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.webp",
    "**/*.pdf",
    "**/*.exe",
    "**/*.dll",
    "**/*.lib",
    "**/*.pdb",
    "**/*.zip",
    "**/*.pack",
    "**/*.idx",
    "**/*.bin",
    "**/*.lock"
  ],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./.cspell/project-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["project-words"],
  "words": [
    "Tauri",
    "tauri",
    "imkey",
    "IMKEY",
    "gdrive",
    "GDRIVE",
    "Gdrive",
    "dbmanager",
    "LASTEXITCODE",
    "taskkill",
    "LIBSQLITE",
    "SQLCIPHER",
    "rustc",
    "nsis",
    "NSIS",
    "splitn",
    "pval",
    "pblock",
    "cblock"
  ]
}
