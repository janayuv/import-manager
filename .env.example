# Copy to `.env` in the repo root (`.env` is gitignored). Never commit real values.

# Optional: Tauri updater / signing (see https://v2.tauri.app/distribute/)
# TAURI_PRIVATE_KEY=
# TAURI_PRIVATE_KEY_PASSWORD=

# Application/API configuration
# API_KEY=

# Desktop admin credentials are created once in the app setup screen and stored
# in your local / shared database (`app_settings`). No build-time secrets.

# Playwright E2E (optional; default password used when unset — see tests)
# E2E_PASSWORD=
