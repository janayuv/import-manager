{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the application.",
  "local": true,
  "windows": ["*"],
  "webviews": ["*"],
  "remote": {
    "urls": ["http://localhost:*", "http://127.0.0.1:*", "tauri://localhost"]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-message",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "**" }]
    }
  ]
}
