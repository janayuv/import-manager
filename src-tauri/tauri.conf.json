{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Import Manager",
  "version": "1.0.0",
  "identifier": "com.jana.importmanager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Import Manager",
        "width": 1100,
        "height": 650,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'unsafe-inline' 'self'",
        "script-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      },
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "sqlcipher.dll",
      "libcrypto-3-x64.dll",
      "libssl-3-x64.dll",
      "zlib1.dll"
    ]
  },
  "plugins": {
    "store": {},
    "dialog": null,
    "fs": null,
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGQjUwNzRCNjdGM0VDMDEKUldRQjdQTm5Td2UxajRLNXVVd1preDZveEdubDlXQ1FJbWhiQTE3WmdWM3V0KzFQancxWGNBamgK",
      "endpoints": [
        "https://github.com/janayuv/import-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
